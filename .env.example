# Set to true ONLY after real data, legal pages, mobile QA, SEO review.
NEXT_PUBLIC_LAUNCH_READY=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEO indexing is an independent, explicit opt-in for the canonical whateato.com domain.
# Set NEXT_PUBLIC_SITE_URL=https://whateato.com on production, then
# WHATEATO_SEO_PUBLIC_ENABLED=true to index only the homepage, the 3 explicitly
# whitelisted restaurants and owner-published blog articles.
# Do NOT set NEXT_PUBLIC_LAUNCH_READY=true. The catalog whitelist stays enforced.
WHATEATO_SEO_PUBLIC_ENABLED=false
# Set only via Hostinger secrets after dedicated WhatEatO database provisioned.
# DATABASE_URL=...


# NEXT.JS SERVER ONLY — Google OIDC sign-in (NOT for GitHub Pages)
# DATABASE_URL=postgresql://.../neondb?sslmode=require
# AUTH_SECRET=use_cryptographically_random_32+_byte_secret
# AUTH_GOOGLE_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# AUTH_GOOGLE_SECRET=your-google-oauth-web-client-secret
# For a trusted reverse proxy, Auth.js may require AUTH_TRUST_HOST=true
# Do not prefix secrets with NEXT_PUBLIC_ and never commit actual values.
# Google OAuth callback: https://YOUR-NEXTJS-DOMAIN/api/auth/callback/google
# Scope requested in code: openid email (NOT profile, Drive, Contacts).

# Phase 1.5: analytics is OFF by default even when migration 004 exists.
# Enable ONLY after WAF/proxy rate limiting, privacy review, and 30-day retention verification.
WHATEATO_ANALYTICS_ENABLED=false
# Server-side secret, minimum 32 characters. Do not publish in NEXT_PUBLIC_* variables.
# WHATEATO_ANALYTICS_ADMIN_TOKEN=replace-with-random-server-only-secret
# GitHub Actions retention requires WHATEATO_ANALYTICS_CLEANUP_ENABLED=true and the NEON_DATABASE_URL secret.
# For staging QA: WHATEATO_STAGING_DATABASE_URL, WHATEATO_EXPECTED_NEON_BRANCH_ID,
# and WHATEATO_PHASE15_STAGING_ACK=I_ACK_STAGING_ONLY are required locally.


# Phase 3 map — disabled until a properly licensed MapTiler plan & per-origin key.
# Public browser key (not a secret). Restrict to your preview/production origin.
# MapTiler Free is not licensed for commercial site operation; confirm plan before enabling.
# NEXT_PUBLIC_MAPTILER_API_KEY=YOUR_RESTRICTED_ORIGIN_BROWSER_KEY
# Leave unset for an honest keyless map placeholder, with no external tile requests.


# Phase 3.5 review moderation admin API — SERVER ONLY, OFF by default.
# WHATEATO_REVIEW_MODERATION_ENABLED=false
# WHATEATO_REVIEW_ADMIN_TOKEN=<unique random 256-bit+ token, at least 32 chars>
# Never use the synthetic token from GitHub Actions in any non-CI environment.
# API endpoints: GET /api/v1/admin/reviews, PATCH /api/v1/admin/reviews/:id
# Provide Authorization: Bearer <token> from trusted HTTPS admin tooling.
# Do not put this secret into any NEXT_PUBLIC_* variables or a browser UI.
# Ensure hosting/proxy WAF rate limits, restrict access where possible,
# and apply migration 007 before enabling on a live database.

# Bulk Content Operations v1 — OFF until 014 migration + staging security QA.
# WHATEATO_BULK_ADMIN_ENABLED=false
# WHATEATO_BULK_ADMIN_TOKEN=<new, random 32+ character, server-side-only bearer>
# Never set token in NEXT_PUBLIC_*, source control, screenshots or browser storage.
# Batch stream tools use a server-side approved HTTPS origin only:
# WHATEATO_ADMIN_API_ORIGIN=https://whateato.onrender.com
# WHATEATO_BULK_IMPORT_ACK=<reviewed-draft-batch-uuid>
# WHATEATO_BULK_EXECUTE_ACK=<approved-batch-uuid>
# Migration: db/migrations/014_bulk_content_operations.sql (staging first).

# Owner/Admin CMS v1. Keep disabled on public site until staging QA & explicit release.
WHATEATO_OWNER_CMS_ENABLED=false
# Owner session is Auth.js Google, plus manually granted whateato_admin_accounts role.
# Requires separate server-side operations secrets (not exposed to browser):
# WHATEATO_BULK_ADMIN_ENABLED=true
# WHATEATO_BULK_ADMIN_TOKEN=<random 256-bit secret>
# WHATEATO_REVIEW_MODERATION_ENABLED=true
# WHATEATO_REVIEW_ADMIN_TOKEN=<different random 256-bit secret>
# Private S3-compatible images (e.g. Cloudflare R2). Store as Render secret vars.
# WHATEATO_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# WHATEATO_S3_BUCKET=whateato-private-media
# WHATEATO_S3_REGION=auto
# WHATEATO_S3_ACCESS_KEY_ID=<private>
# WHATEATO_S3_SECRET_ACCESS_KEY=<private>
# Apply 014+015 to staging only before enabling. Never auto-grant owner access.
