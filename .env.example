# Set to true ONLY after real data, legal pages, mobile QA, SEO review.
NEXT_PUBLIC_LAUNCH_READY=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set only via Hostinger secrets after dedicated WhatEatO database provisioned.
# DATABASE_URL=...


# NEXT.JS SERVER ONLY — Google OIDC sign-in (NOT for GitHub Pages)
# DATABASE_URL=postgresql://.../neondb?sslmode=require
# AUTH_SECRET=use_cryptographically_random_32+_byte_secret
# AUTH_GOOGLE_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# AUTH_GOOGLE_SECRET=your-google-oauth-web-client-secret
# For a trusted reverse proxy, Auth.js may require AUTH_TRUST_HOST=true
# Do not prefix secrets with NEXT_PUBLIC_ and never commit actual values.
# Google OAuth callback: https://YOUR-NEXTJS-DOMAIN/api/auth/callback/google
# Scope requested in code: openid email (NOT profile, Drive, Contacts).
